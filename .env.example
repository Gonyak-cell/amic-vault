# Development-only defaults. Do not put real secrets in this file.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=amic_vault
POSTGRES_USER=amic_vault
POSTGRES_PASSWORD=amic_vault_dev_password
# Owner-only migration/seed connection. Never pass this to API or worker.
DATABASE_MIGRATION_URL=postgres://amic_vault:amic_vault_dev_password@localhost:5432/amic_vault
# API/worker runtime identity. Startup rejects an absent value before listening.
DATABASE_RUNTIME_URL=postgres://vault_app:vault_app_dev_password@localhost:5432/amic_vault
DATABASE_RUNTIME_ROLE=vault_app
# Legacy direct-pool consumers receive DATABASE_RUNTIME_URL only during startup;
# do not configure DATABASE_URL as an owner/runtime fallback.
DATABASE_URL=
APP_DATABASE_URL=postgres://vault_app:vault_app_dev_password@localhost:5432/amic_vault

MINIO_ROOT_USER=amic-vault-minio
MINIO_ROOT_PASSWORD=amic-vault-minio-dev-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=amic-vault-dev
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=amic-vault-minio
S3_SECRET_ACCESS_KEY=amic-vault-minio-dev-password
# Optional worker-visible endpoint for presigned read URLs when workers run in a different network namespace.
S3_READ_URL_ENDPOINT=
# Set to AES256 only when the backing S3/MinIO profile has SSE-S3 enabled.
S3_SERVER_SIDE_ENCRYPTION=
DOCUMENT_ALLOWED_EXTENSIONS=pdf,docx,hwpx
DOCUMENT_UPLOAD_MAX_BYTES=524288000

# The development-only direct worker profile is never valid in production.
# Production uses a private gateway that terminates mTLS, strips caller-supplied
# identity headers, and injects the verified workload subject/audience below.
INGESTION_WORKER_IDENTITY_PROFILE=loopback-dev
INGESTION_GATEWAY_MTLS_ENABLED=false
INGESTION_GATEWAY_SANITIZES_IDENTITY_HEADERS=false
INGESTION_GATEWAY_DIRECT_WORKER_ACCESS=loopback-only
INGESTION_GATEWAY_WORKLOAD_SUBJECT=amic-vault-api
INGESTION_GATEWAY_AUDIENCE=amic-vault-ingestion

API_PORT=3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/v1

# Matter app source-of-truth gates. Keep runtime ready false until an approved
# Matter app lookup API or event projection is live and smoke-tested.
NEXT_PUBLIC_MATTER_APP_SOURCE_MODE=unconfigured
NEXT_PUBLIC_MATTER_APP_SOURCE_CONFIGURED=false
NEXT_PUBLIC_MATTER_APP_RUNTIME_READY=false
NEXT_PUBLIC_ALLOW_VAULT_PROJECTION_MATTER_SOURCE=false

# Outlook add-in gates remain fail-closed until an explicit M365 integration approval.
OUTLOOK_ADDIN_ENABLED=false
OUTLOOK_AUTH_EXCHANGE_ENABLED=false
OUTLOOK_GRAPH_ATTACHMENT_ACQUISITION_ENABLED=false
OUTLOOK_SMART_ALERTS_ENABLED=false
OUTLOOK_SEND_FILE_ENABLED=false
OUTLOOK_DOCUMENT_INSERTION_ENABLED=false
OUTLOOK_FOLDER_MAPPING_ENABLED=false
OUTLOOK_AUTOFILE_ENABLED=false
