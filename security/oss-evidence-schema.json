{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AMIC Vault OSS evidence manifest v1",
  "required": [
    "pack",
    "tuw",
    "sourceSha",
    "sourceTree",
    "upstreamInputs",
    "commands",
    "artifacts",
    "truthState",
    "syntheticOnly",
    "externalEvidence",
    "vulnerabilityDecisionReference"
  ],
  "upstreamInputRequired": [
    "inputKey",
    "kind",
    "manifestPath",
    "fileInclusion",
    "upstreamUrl",
    "upstreamSha",
    "upstreamTree",
    "licenseHash",
    "artifactDigest",
    "owner",
    "evidenceState",
    "modifier"
  ],
  "truthStates": [
    "SOURCE_IMPLEMENTED",
    "LOCAL_FOCUSED_VERIFIED",
    "LOCAL_VERIFIED",
    "CI_VERIFIED",
    "EXTERNAL_BLOCKED"
  ],
  "scanSummaryRequired": [
    "schema",
    "sourceSha",
    "sourceTree",
    "toolPins",
    "findingCount",
    "productionHighCritical",
    "findings"
  ],
  "scanFindingDecisions": [
    "BLOCKED",
    "NOT_REQUIRED",
    "VEX_APPROVED"
  ],
  "unsignedReleaseIdentityRequired": [
    "schema",
    "predicateType",
    "sourceSha",
    "sourceTree",
    "artifacts",
    "policy",
    "localIntegrity",
    "releaseSafe"
  ],
  "signingBoundaryStatus": "EXTERNAL_BLOCKED_SIGNING_IDENTITY_REQUIRED"
}
